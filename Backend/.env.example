# Copier ce fichier en `.env` et remplir les valeurs réelles. `.env` n'est jamais commité —
# `.env.example` sert de documentation.

SECRET_KEY=change-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de données (Supabase Postgres, pooler partagé) ──────────────────────
# Dashboard Supabase → Connect → Connection string / Connection parameters.
# DB_HOST ressemble à aws-0-<region>.pooler.supabase.com
# DB_USER ressemble à postgres.<ref-du-projet>
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ── CORS ───────────────────────────────────────────────────────────────────
# Domaines supplémentaires autorisés (séparés par des virgules), en plus de
# localhost:3000 déjà autorisé par défaut.
CORS_ALLOWED_ORIGINS=

# ── Super admin de secours ────────────────────────────────────────────────
# Créé automatiquement au démarrage si aucun superuser n'existe déjà.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULL_NAME=Super Admin

# ── Stockage média (Cloudinary) ───────────────────────────────────────────
# Laisser vide en développement (fichiers servis depuis Backend/media/).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
